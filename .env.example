# Copie este arquivo para ".env" e preencha. NUNCA envie o .env ao GitHub.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# --- IA (necessário a partir da etapa dos agentes) ---
# Chave gratuita: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelo Gemini dos agentes (identificador conferido na documentação oficial; padrão do projeto).
MODEL=gemini-3.5-flash-lite

# --- Armazenamento de arquivos ---
# "local" lê a pasta DATA_DIR. "gcs" (Google Cloud Storage) ainda não está implementado.
STORAGE_BACKEND=local
DATA_DIR=data
# Usados somente com STORAGE_BACKEND=gcs
GCS_BUCKET=
GCS_PREFIX=

# --- Índice vetorial (ChromaDB, etapa do RAG) ---
VECTOR_STORE_DIR=.vectorstore
